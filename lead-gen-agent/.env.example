# =============================================================
# AI Lead Generation Agent — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================


# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Your Anthropic API key — the only paid dependency for core functionality
ANTHROPIC_API_KEY=sk-ant-...


# ── SEARCH PROVIDERS (pick one, or leave unset for free Google fallback) ──────

# Tavily — recommended (reliable, structured results, ~$0.001/search)
# Get key at: https://tavily.com
TAVILY_API_KEY=

# Brave Search API — alternative (generous free tier: 2,000 queries/month)
# Get key at: https://brave.com/search/api/
BRAVE_API_KEY=


# ── API SECURITY ──────────────────────────────────────────────────────────────

# Set a random secret to enable API key auth.
# Leave blank to disable auth (useful for local dev / self-hosted).
# Clients pass:  X-API-Key: <value>  or  Authorization: Bearer <value>
API_KEY=

# Webhook signing secret — if set, POST payloads include X-Lead-Gen-Signature
# header (HMAC-SHA256). Leave blank to disable signing.
WEBHOOK_SECRET=


# ── GOOGLE SHEETS EXPORT (optional) ──────────────────────────────────────────

# Path to your Google service account JSON key file.
# Get one at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SHEETS_KEY_FILE=


# ── MODEL CONFIGURATION ───────────────────────────────────────────────────────

# Claude model to use for enrichment, scoring, and outreach generation.
CLAUDE_MODEL=claude-sonnet-4-20250514


# ── PERFORMANCE TUNING ────────────────────────────────────────────────────────

# Max concurrent lead enrichment workers (increase for faster runs, higher cost)
ENRICHMENT_CONCURRENCY=3

# Max concurrent lead gen runs via the API
MAX_CONCURRENT_RUNS=3

# Request delay range (seconds) between Google searches (ignored for Tavily/Brave)
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5


# ── STORAGE ───────────────────────────────────────────────────────────────────

# SQLite database path. In Docker, mount a volume to /app/data and set:
# DATABASE_URL=/app/data/leads.db
DATABASE_URL=leads.db


# ── API SERVER ────────────────────────────────────────────────────────────────

# Port for the REST API server
API_PORT=3000

# CORS allowed origins (comma-separated). Use "*" to allow all.
# Example: https://app.yourco.com,https://dashboard.yourco.com
CORS_ORIGINS=*

# Requests per minute per IP (default: 60)
RATE_LIMIT_PER_MINUTE=60
