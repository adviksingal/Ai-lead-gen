# =============================================================
# AI Lead Generation Agent — Environment Variables
# =============================================================

# ---- REQUIRED ------------------------------------------------
# Your Anthropic API key (the ONLY paid dependency)
ANTHROPIC_API_KEY=sk-ant-...

# ---- OPTIONAL: Google Sheets export --------------------------
# Path to your Google service account JSON key file
# Get one free at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SHEETS_KEY_FILE=service_account.json

# ---- TUNING --------------------------------------------------
# Claude model to use (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Max concurrent enrichment workers (default: 3)
ENRICHMENT_CONCURRENCY=3

# Request delay range in seconds to avoid Google blocks (default: 2-5)
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5

# SQLite database file path (default: leads.db)
DATABASE_URL=leads.db

# API server port (default: 3000)
API_PORT=3000
